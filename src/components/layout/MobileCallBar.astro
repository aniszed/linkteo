---
// Barre d'action fixe en bas d'écran, mobile uniquement : visible en permanence sur chantier.
import Icon from '~/components/icons/Icon.astro';
import { contact } from '~/content/site-config';

const tel = contact.telephone;
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-nuit-700 bg-nuit pb-[env(safe-area-inset-bottom)] md:hidden">
  <div class="flex h-16 gap-2 px-3 py-2">
    {tel ? (
      <>
        <a href={`tel:${tel.international}`} class="btn-orange h-full min-h-0 flex-1 px-2">
          <Icon name="telephone" class="size-5" />Appeler
        </a>
        <a href="/#contact" class="btn-contour-clair h-full min-h-0 flex-1 px-2">Devis</a>
      </>
    ) : (
      <a href="/#contact" class="btn-orange h-full min-h-0 flex-1 px-2">
        Demander un devis<Icon name="fleche" class="size-5" />
      </a>
    )}
  </div>
</div>
