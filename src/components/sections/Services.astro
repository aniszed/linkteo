---
import Icon from '~/components/icons/Icon.astro';
import SectionTitre from '~/components/ui/SectionTitre.astro';
import { prestations, estPubliee } from '~/content/site-config';
---
<section id="prestations" aria-labelledby="prestations-titre" class="py-16 md:py-24">
  <div class="conteneur">
    <SectionTitre numero="01" repere="Prestations" titre="Ce que nous faisons sur le réseau" id="prestations-titre">
      Sur le réseau de distribution, du sous-répartiteur optique jusqu’aux points de branchement.
    </SectionTitre>

    <ul class="mt-12 grid gap-px overflow-hidden rounded-md border border-filet bg-filet sm:grid-cols-2 lg:grid-cols-3">
      {prestations.map((p) => {
        const lien = estPubliee(p.page);
        return (
          <li class="apparait group relative flex flex-col bg-white p-6 sm:p-7">
            <span class="flex size-12 items-center justify-center rounded-md bg-surface text-nuit ring-1 ring-filet group-hover:ring-orange">
              <Icon name={p.icone} class="size-7" />
            </span>
            <h3 class="mt-5 text-xl font-bold">
              {lien ? (
                <a href={p.page} class="after:absolute after:inset-0 hover:text-orange-fonce">{p.titre}</a>
              ) : p.titre}
            </h3>
            <p class="mt-2 text-ardoise">{p.resume}</p>
            <ul class="mt-4 space-y-1.5 text-[0.95rem]">
              {p.points.map((pt) => (
                <li class="flex gap-2"><Icon name="check" class="mt-1 size-4 shrink-0 text-orange-fonce" />{pt}</li>
              ))}
            </ul>
            {lien && (
              <span class="mt-auto flex items-center gap-1 pt-5 font-display text-sm font-bold text-nuit" aria-hidden="true">
                En savoir plus <Icon name="fleche" class="size-4 transition-transform group-hover:translate-x-1" />
              </span>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>
