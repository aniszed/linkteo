---
import Icon from '~/components/icons/Icon.astro';
import SectionTitre from '~/components/ui/SectionTitre.astro';

const etapes = [
  {
    icone: 'email',
    titre: 'Demande',
    texte:
      'Le conducteur de travaux nous transmet le dossier : secteur, plans et synoptique, plans de boîte, délais.',
  },
  {
    icone: 'calendrier',
    titre: 'Planification',
    texte:
      'Nous vérifions le dossier, signalons ce qui manque, puis confirmons les dates, les accès (chambres, appuis, immeubles) et le matériel.',
  },
  {
    icone: 'outil',
    titre: 'Intervention',
    texte:
      'Tirage, pose des boîtiers et soudure selon les règles d’ingénierie de l’opérateur d’infrastructure : lovage, étiquetage, chantier balisé.',
  },
  {
    icone: 'rapport',
    titre: 'Compte rendu',
    texte:
      'Photos des boîtiers et des cheminements, mesures de recette, réserves et éléments pour le DOE, au format demandé.',
  },
] as const;
---
<section aria-labelledby="process-titre" class="border-y border-filet bg-surface py-16 md:py-24">
  <div class="conteneur">
    <SectionTitre numero="02" repere="Méthode" titre="Comment se passe une intervention" id="process-titre">
      Quatre étapes, les mêmes pour un dossier de déploiement ou une série de reprises.
    </SectionTitre>

    <ol class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {etapes.map((e, i) => (
        <li class="apparait relative">
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded-md bg-nuit font-display text-lg font-bold text-white">
              {i + 1}
            </span>
            <span class="hidden h-px flex-1 bg-filet lg:block" aria-hidden="true"></span>
            <Icon name={e.icone} class="size-6 text-ardoise" />
          </div>
          <h3 class="mt-4 text-xl font-bold">{e.titre}</h3>
          <p class="mt-2 text-ardoise">{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
