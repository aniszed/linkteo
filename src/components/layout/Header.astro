---
import Logo from './Logo.astro';
import Icon from '~/components/icons/Icon.astro';
import { contact, navigation, estPubliee } from '~/content/site-config';

const liens = navigation.filter((l) => estPubliee(l.href));
const tel = contact.telephone;
---
<header class="sticky top-0 z-40 border-b border-filet bg-white">
  <div class="conteneur flex h-16 items-center justify-between gap-6">
    <a href="/" class="text-nuit" aria-label="Linkteo, retour à l’accueil">
      <Logo class="h-8 w-auto sm:h-9" />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-7 font-display text-[0.95rem] font-bold text-nuit">
        {liens.map((l) => (
          <li><a href={l.href} class="py-2 hover:text-orange-fonce">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      {tel ? (
        <a href={`tel:${tel.international}`} class="btn-orange min-h-10 px-4 text-[0.95rem]">
          <Icon name="telephone" class="size-5" />{tel.affichage}
        </a>
      ) : (
        <a href="/#contact" class="btn-orange min-h-10 px-4 text-[0.95rem]">Demander un devis</a>
      )}
    </div>

    <!-- Menu mobile sans JavaScript -->
    <details class="group relative lg:hidden">
      <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md text-nuit hover:bg-surface [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu">
        <svg class="size-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg class="hidden size-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </summary>
      <nav aria-label="Navigation mobile" class="absolute right-0 top-13 w-64 border border-filet bg-white p-2 shadow-lg">
        <ul class="font-display font-bold text-nuit">
          {liens.map((l) => (
            <li><a href={l.href} class="block rounded-sm px-4 py-3 hover:bg-surface">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
