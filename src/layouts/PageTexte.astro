---
/** Gabarit des pages de texte (mentions légales, confidentialité, 404, merci). */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  repere?: string;
  noindex?: boolean;
}
const { title, description, h1, repere, noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="border-b border-filet bg-surface">
    <div class="conteneur py-12 md:py-16">
      {repere && <p class="repere">{repere}</p>}
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">{h1}</h1>
    </div>
  </div>
  <div class="conteneur py-12 md:py-16">
    <div class="texte max-w-3xl">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .texte :global(h2) { font-size: 1.5rem; font-weight: 700; margin-top: 2.5rem; }
  .texte :global(h2:first-child) { margin-top: 0; }
  .texte :global(p), .texte :global(ul), .texte :global(dl) { margin-top: 1rem; }
  .texte :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .texte :global(li + li) { margin-top: 0.35rem; }
  .texte :global(dt) { font-weight: 600; color: var(--color-nuit); margin-top: 0.75rem; }
  .texte :global(a) { color: var(--color-nuit); text-decoration: underline; text-decoration-color: var(--color-orange); text-underline-offset: 4px; }
</style>
