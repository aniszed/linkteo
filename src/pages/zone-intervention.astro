---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/icons/Icon.astro';
import FilAriane from '~/components/ui/FilAriane.astro';
import SectionTitre from '~/components/ui/SectionTitre.astro';
import CarteIdf from '~/components/diagrams/CarteIdf.astro';
import CtaBande from '~/components/sections/CtaBande.astro';
import { zones, type Couronne } from '~/content/site-config';
import { breadcrumbLd, serviceLd } from '~/lib/schema';

const site = Astro.site ?? new URL('https://linkteo.com');
const href = '/zone-intervention';
const title = 'Zone d’intervention : fibre optique en Île-de-France — Linkteo';
const description =
  'Déploiement D2, soudure, maintenance et dépannage fibre dans les 8 départements d’Île-de-France : Paris, petite couronne et grande couronne.';

const ariane = [
  { nom: 'Accueil', href: '/' },
  { nom: 'Zone d’intervention', href },
];
const jsonLd = [
  serviceLd(site, {
    nom: 'Interventions fibre optique en Île-de-France',
    serviceType: 'Déploiement, soudure et maintenance FTTH',
    description,
    href,
  }),
  breadcrumbLd(site, ariane),
];

const groupes: { id: Couronne; titre: string; texte: string }[] = [
  {
    id: 'paris',
    titre: 'Paris',
    texte: 'Zone très dense : le travail se fait presque entièrement en immeuble. La difficulté est rarement technique, elle est logistique : accès, horaires, stationnement.',
  },
  {
    id: 'petite',
    titre: 'Petite couronne',
    texte: 'Habitat collectif dense et quartiers pavillonnaires se côtoient. Une même journée peut mêler colonne montante, souterrain et façade.',
  },
  {
    id: 'grande',
    titre: 'Grande couronne',
    texte: 'Pavillonnaire, villes nouvelles et secteurs ruraux. Le réseau aérien sur poteaux y est fréquent, et une partie du territoire relève de réseaux d’initiative publique.',
  },
];
const couvertes = zones.filter((z) => z.couvert);
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="border-b border-filet bg-surface">
    <div class="conteneur py-10 md:py-14">
      <FilAriane items={ariane} />
      <p class="repere mt-8">Zone d’intervention</p>
      <h1 class="mt-3 max-w-4xl text-[2rem] font-bold sm:text-5xl">Fibre optique en Île-de-France : les 8 départements</h1>
      <p class="mt-5 max-w-3xl text-lg text-ardoise">
        Déploiement D2, soudure, maintenance et dépannage sur l’ensemble de la région. Le terrain change d’un département
        à l’autre : voici ce que nous y rencontrons, et comment nous nous y préparons.
      </p>
    </div>
  </section>

  <section aria-label="Carte" class="py-12 md:py-16">
    <div class="conteneur">
      <CarteIdf zoom ancres />
      <p class="mt-4 text-xs text-ardoise">Contours : IGN Admin Express, Licence Ouverte. Cliquez sur un département pour accéder à sa fiche.</p>
    </div>
  </section>

  {groupes.map((g, i) => {
    const deps = couvertes.filter((z) => z.couronne === g.id);
    return (
      <section aria-labelledby={`g-${g.id}`} class:list={['py-14 md:py-16', i % 2 === 0 ? 'border-t border-filet bg-surface' : 'border-t border-filet']}>
        <div class="conteneur">
          <SectionTitre numero={`0${i + 1}`} repere={deps.length > 1 ? `Départements ${deps.map((z) => z.code).join(" · ")}` : `Département ${deps.map((z) => z.code).join("")}`} titre={g.titre} id={`g-${g.id}`}>{g.texte}</SectionTitre>
          <div class:list={['mt-10 grid gap-5', deps.length > 1 && 'md:grid-cols-2']}>
            {deps.map((z) => (
              <article id={`dep-${z.code}`} class="apparait scroll-mt-24 rounded-md border border-filet bg-white p-6 sm:p-7">
                <h3 class="flex items-baseline gap-3 text-xl font-bold">
                  <span class="font-display text-2xl text-orange-fonce">{z.code}</span>{z.nom}
                </h3>
                <p class="mt-3 text-ardoise">{z.terrain}</p>
                <p class="mt-4 flex gap-2 text-[0.95rem]">
                  <Icon name="repere" class="mt-0.5 size-5 shrink-0 text-ardoise" />
                  <span><span class="font-medium text-nuit">Communes :</span> {z.communes.join(', ')}{z.communes.length > 1 ? ' et alentours' : ''}.</span>
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section aria-labelledby="hors-zone" class="border-t border-filet py-14 md:py-16">
    <div class="conteneur max-w-3xl">
      <h2 id="hors-zone" class="text-2xl font-bold">Une intervention en limite de région ?</h2>
      <p class="mt-3 text-ardoise">
        Pour un chantier dans une commune limitrophe de l’Île-de-France (Oise, Eure-et-Loir, Loiret…), décrivez-nous
        le besoin : nous vous répondons selon le volume et la localisation.
      </p>
    </div>
  </section>

  <CtaBande titre="Une intervention dans votre secteur ?" />
</BaseLayout>
