---
// Logo officiel (brand/linkteo-logo.svg), recoloré via currentColor.
import raw from '../../../brand/linkteo-logo.svg?raw';

interface Props {
  class?: string;
}
const { class: className = 'h-9 w-auto' } = Astro.props;

const svg = raw
  .replace(/<title>.*?<\/title>/, '')
  // Retire uniquement width/height de la balise <svg> (pas ceux du carré d'épissure).
  .replace(/<svg([^>]*?)\swidth="[^"]*"\sheight="[^"]*"/, '<svg$1')
  .replace(/role="img" aria-label="Linkteo"/, 'aria-hidden="true" focusable="false"')
  .replaceAll('#0B1F33', 'currentColor')
  .replace('<svg ', `<svg class="${className}" `);
---
<Fragment set:html={svg} />
