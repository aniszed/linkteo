---
/** Bandeau d'appel à l'action de bas de page. */
import Icon from '~/components/icons/Icon.astro';
import { contact } from '~/content/site-config';

interface Props {
  titre?: string;
  texte?: string;
}
const {
  titre = 'Une intervention à confier ?',
  texte = 'Adresse, volume, délai : décrivez le besoin, nous revenons vers vous avec une réponse chiffrée.',
} = Astro.props;
const tel = contact.telephone;
---
<section class="bg-nuit text-white">
  <div class="conteneur flex flex-col gap-6 py-12 md:flex-row md:items-center md:justify-between md:py-14">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold !text-white sm:text-3xl">{titre}</h2>
      <p class="mt-2 text-brume">{texte}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      {tel && (
        <a href={`tel:${tel.international}`} class="btn-orange"><Icon name="telephone" class="size-5" />{tel.affichage}</a>
      )}
      <a href="/#contact" class:list={[tel ? 'btn-contour-clair' : 'btn-orange']}>Demander un devis<Icon name="fleche" class="size-5" /></a>
    </div>
  </div>
</section>
