---
/**
 * Icônes métier dessinées pour Linkteo (grille 24 × 24, trait 1.75).
 * Inline, sans dépendance. Ajouter une icône = ajouter une entrée dans `paths`.
 */
import type { IconName } from '~/content/site-config';

type UiIcon = 'telephone' | 'email' | 'check' | 'fleche' | 'document' | 'horloge' | 'repere' | 'calendrier' | 'outil' | 'rapport' | 'echelle';

interface Props {
  name: IconName | UiIcon;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-6', label } = Astro.props;

const paths: Record<IconName | UiIcon, string> = {
  // PBO (boîtier) → câble D3 → logement avec PTO
  raccordement: 'M2.5 9h5v7h-5zM7.5 12.5h4.5M12 20.5v-8l5-4 5 4v8zM15.5 15.5h3v3h-3z',
  // Lien coupé + trace de diagnostic
  sav: 'M2 12h5M17 12h5M7 12l2-4 2.5 8L14 9l1.5 3H17',
  // Boîtier ouvert, contrôle validé
  maintenance: 'M4 9h16v11H4zM4 9l2.5-4.5h11L20 9M8.5 14.5l2.5 2.5 4.5-4.5',
  // Liste de reprises cochées
  malfacon: 'M9 3.5h6v3H9zM9 5H5.5v15.5h13V5H15M8 11l1.5 1.5L12 10M14 11.5h2.5M8 16.5l1.5 1.5L12 15.5M14 17h2.5',
  // Écran de réflectomètre avec trace
  mesure: 'M3 4.5h18v12H3zM5.5 9.5h3l1 1h3.5l1 3.5 1-3.5h3.5M9 20.5h6M12 16.5v4',
  // Poteau, traverse, câble aérien
  poteau: 'M12 3v18M8 6h8M7.5 21h9M3 10.5c3 2 6 2 9 0M12 10.5c3 2 6 2 9 0',

  telephone: 'M5 3.5h4l2 5-2.5 1.5a11 11 0 0 0 5.5 5.5L15.5 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5.5a2 2 0 0 1 2-2z',
  email: 'M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7',
  check: 'M4.5 12.5l5 5 10-11',
  fleche: 'M4 12h15M13.5 6.5 19 12l-5.5 5.5',
  document: 'M6 2.5h8.5L19 7v14.5H6zM14 2.5V7.5h5M9 12h7M9 15.5h7M9 19h4',
  horloge: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5.5l3.5 2',
  repere: 'M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z',
  calendrier: 'M4 5.5h16v15H4zM4 10h16M8.5 3v5M15.5 3v5M8 14h3v3H8z',
  outil: 'M14.5 3.5a5 5 0 0 0-4.6 6.9L3.5 16.8l3.7 3.7 6.4-6.4A5 5 0 0 0 20.5 9.5l-3 3-3-3 3-3a5 5 0 0 0-3-3z',
  rapport: 'M5 3.5h14v17H5zM8.5 15.5v-3M12 15.5v-6M15.5 15.5v-4.5M8.5 18h7',
  echelle: 'M7 2.5v19M17 2.5v19M7 6.5h10M7 11h10M7 15.5h10M7 20h10',
};
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
><path d={paths[name]} /></svg>
