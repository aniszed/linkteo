---
/**
 * Formulaire de contact — Netlify Forms (aucun backend, aucune clé tierce).
 * Netlify détecte le formulaire au déploiement grâce à data-netlify="true".
 * Les envois arrivent dans Netlify > Forms, avec notification par email à configurer.
 */
import Icon from '~/components/icons/Icon.astro';
import SectionTitre from '~/components/ui/SectionTitre.astro';
import { contact, zones, estPubliee } from '~/content/site-config';

const tel = contact.telephone;
const champ =
  'mt-1.5 block w-full rounded-md border border-brume bg-white px-3.5 py-3 text-base text-encre placeholder:text-ardoise/70 focus:border-nuit focus:outline-none focus:ring-2 focus:ring-orange';
const label = 'block font-display text-[0.95rem] font-bold text-nuit';
const confidentialite = '/politique-de-confidentialite';
---
<section id="contact" aria-labelledby="contact-titre" class="py-16 md:py-24">
  <div class="conteneur grid gap-12 lg:grid-cols-[1fr_1.5fr]">
    <div>
      <SectionTitre numero="06" repere="Contact" titre="Une intervention, un volume, un référencement ?" id="contact-titre">
        Décrivez votre besoin en quelques lignes. Plus la demande est précise (adresse, volume, délai),
        plus la réponse est rapide et chiffrée.
      </SectionTitre>

      <ul class="mt-8 space-y-4">
        {tel && (
          <li>
            <a href={`tel:${tel.international}`} class="flex items-center gap-3 font-display text-xl font-bold text-nuit hover:text-orange-fonce">
              <span class="flex size-11 items-center justify-center rounded-md bg-orange text-nuit"><Icon name="telephone" class="size-5" /></span>
              {tel.affichage}
            </a>
          </li>
        )}
        {contact.email && (
          <li>
            <a href={`mailto:${contact.email}`} class="flex items-center gap-3 font-medium text-nuit hover:text-orange-fonce">
              <span class="flex size-11 items-center justify-center rounded-md bg-surface ring-1 ring-filet"><Icon name="email" class="size-5" /></span>
              {contact.email}
            </a>
          </li>
        )}
        <li class="flex items-center gap-3 text-ardoise">
          <span class="flex size-11 items-center justify-center rounded-md bg-surface ring-1 ring-filet text-nuit"><Icon name="horloge" class="size-5" /></span>
          {contact.horaires}
        </li>
      </ul>
    </div>

    <form
      name="contact"
      method="POST"
      action="/merci"
      data-netlify="true"
      netlify-honeypot="adresse-web"
      class="rounded-md border border-filet bg-surface p-5 sm:p-8"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden" aria-hidden="true">
        <label>Ne pas remplir <input name="adresse-web" tabindex="-1" autocomplete="off" /></label>
      </p>

      <fieldset>
        <legend class={label}>Votre demande</legend>
        <div class="mt-2 grid gap-2 sm:grid-cols-2">
          {[
            ['devis', 'Demande de devis'],
            ['referencement', 'Référencement sous-traitant'],
            ['ponctuelle', 'Intervention ponctuelle'],
            ['autre', 'Autre'],
          ].map(([value, texte], i) => (
            <label class="relative flex min-h-12 cursor-pointer items-center gap-3 rounded-md border border-brume bg-white px-3.5 py-2">
              <input type="radio" name="type" value={value} checked={i === 0} required class="peer size-4 accent-nuit" />
              <span class="text-[0.95rem]">{texte}</span>
              <span class="pointer-events-none absolute -inset-px rounded-md peer-checked:border-2 peer-checked:border-orange" aria-hidden="true"></span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nom" class={label}>Nom et prénom</label>
          <input id="nom" name="nom" type="text" autocomplete="name" required class={champ} />
        </div>
        <div>
          <label for="societe" class={label}>Société <span class="font-normal text-ardoise">(si applicable)</span></label>
          <input id="societe" name="societe" type="text" autocomplete="organization" class={champ} />
        </div>
        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={champ} />
        </div>
        <div>
          <label for="telephone" class={label}>Téléphone</label>
          <input id="telephone" name="telephone" type="tel" autocomplete="tel" inputmode="tel" class={champ} />
        </div>
        <div class="sm:col-span-2">
          <label for="departement" class={label}>Département d’intervention</label>
          <select id="departement" name="departement" class={champ}>
            <option value="">Non précisé / plusieurs</option>
            {zones.map((z) => <option value={z.code}>{z.code} — {z.nom}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class={label}>Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class={champ}
            placeholder="Type d’intervention, adresse ou commune, volume, délai souhaité…"
          ></textarea>
        </div>
      </div>

      <p class="mt-5 text-sm text-ardoise">
        Vos informations servent uniquement à répondre à votre demande.
        {estPubliee(confidentialite) && <> Voir notre <a class="lien" href={confidentialite}>politique de confidentialité</a>.</>}
      </p>

      <button type="submit" class="btn-orange mt-6 w-full sm:w-auto">
        Envoyer la demande<Icon name="fleche" class="size-5" />
      </button>
    </form>
  </div>
</section>
