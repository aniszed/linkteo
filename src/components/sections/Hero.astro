---
import NetworkDiagram from '~/components/diagrams/NetworkDiagram.astro';
import Icon from '~/components/icons/Icon.astro';
import { contact, zones } from '~/content/site-config';

const tel = contact.telephone;
const codes = zones.filter((z) => z.couvert).map((z) => z.code).join(' · ');
---
<section class="relative overflow-hidden bg-nuit text-white">
  <!-- Trame de plan, purement décorative -->
  <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.07]" aria-hidden="true">
    <defs>
      <pattern id="trame" width="32" height="32" patternUnits="userSpaceOnUse">
        <path d="M32 0H0V32" fill="none" stroke="#fff" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#trame)" />
  </svg>

  <div class="conteneur relative grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:py-24">
    <div>
      <p class="repere text-brume">Sous-traitance FTTH · Île-de-France</p>
      <h1 class="mt-4 text-[2.1rem] font-bold text-white sm:text-5xl lg:text-[3.4rem]">
        Raccordement et maintenance fibre optique en Île-de-France
      </h1>
      <p class="mt-5 max-w-xl text-lg text-brume">
        Raccordements D3, SAV, reprises de malfaçon et mesures optiques pour les intégrateurs,
        opérateurs et exploitants de réseaux. Interventions en immeuble, en pavillon, en aérien et en façade.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {tel ? (
          <a href={`tel:${tel.international}`} class="btn-orange">
            <Icon name="telephone" class="size-5" />Appeler le {tel.affichage}
          </a>
        ) : (
          <a href="#contact" class="btn-orange">Demander un devis<Icon name="fleche" class="size-5" /></a>
        )}
        <a href="#donneurs-ordre" class="btn-contour-clair">Vous êtes donneur d’ordre</a>
      </div>

      <p class="mt-8 flex items-start gap-2 text-sm text-brume">
        <Icon name="repere" class="mt-0.5 size-5 shrink-0 text-orange" />
        <span>Départements couverts<br /><span class="font-display text-base font-bold tracking-wide text-white">{codes}</span></span>
      </p>
    </div>

    <div class="rounded-md border border-nuit-700 bg-nuit p-4 sm:p-6">
      <NetworkDiagram theme="sombre" />
      <p class="mt-3 border-t border-nuit-700 pt-3 text-sm text-brume">
        Notre cœur de métier : le <strong class="font-display text-orange">D3</strong>, du point de branchement à la prise du client.
      </p>
    </div>
  </div>
</section>
